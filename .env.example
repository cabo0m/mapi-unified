# MAPI public release candidate configuration.
# Prefer `mapi-init`; this file documents available variables.

# Optional discovery root for generated first-run state.
MAPI_INSTANCE_ROOT=~/.mapi-agent-memory

# Explicit runtime root. `mapi-init` writes an absolute path here.
MAPI_ROOT=~/.mapi-agent-memory
# Copy this file to .env only if your launcher loads environment files.

# MAPI_DATA_DIR: Local persistent data directory. Optional. Default: ./data.
# Security: keep it private and backed up; it contains agent memories.
MAPI_REPOSITORY_ROOT=.
MAPI_DATA_DIR=./data

# MAPI_DB_PATH: SQLite database path. Optional. Default: ./data/mapi.db.
# Security: anyone who can read this file can read stored memories.
MAPI_DB_PATH=./data/mapi.db

# MAPI_RUNTIME_HOST: HTTP bind address. Optional. Safe default: loopback only.
# Security: changing this to a LAN/public address requires external authentication and TLS.
MAPI_RUNTIME_HOST=127.0.0.1

# MAPI_RUNTIME_PORT: Local MCP HTTP port. Optional.
MAPI_RUNTIME_PORT=8015
MAPI_SYSTEMD_SERVICE_NAME=mapi.service

# MCP_SURFACE_PROFILE: reader, agent, maintainer or admin. Optional.
# Security: agent is the safe quickstart profile; admin exposes dangerous local operations.
MCP_SURFACE_PROFILE=agent

# MAPI_ADMIN_TOOLS_ENABLED: Additional explicit gate for public admin tooling.
# Optional. Keep false unless a trusted local operator is present.
MAPI_ADMIN_TOOLS_ENABLED=false

# Optional guarded project-file access. Prefer one parent workspace root instead of one root per project.
# Multiple roots use the OS path separator: ';' on Windows and ':' on Linux.
MAPI_FILES_ENABLED=false
MAPI_FILE_ROOTS=
MAPI_FILE_READ_MAX_BYTES=262144

# Guarded writes are a separate opt-in. Write roots must also be present in MAPI_FILE_ROOTS.
MAPI_FILE_WRITE_ENABLED=false
MAPI_FILE_WRITE_ROOTS=
MAPI_FILE_WRITE_MAX_BYTES=262144

# Optional project bindings. The special key "*" means every project key in this MAPI instance.
# Example: {"*" : ["C:/Projects"]}
MAPI_FILE_PROJECT_ROOTS_JSON={}
MAPI_FILE_PROJECT_WRITE_ROOTS_JSON={}

# Built-in single-owner OAuth login for vps-remote-auth.
# mapi-init writes these only for remote-auth deployments.
MAPI_REMOTE_OWNER_LOGIN=owner
# Store only a PBKDF2 hash produced by mapi-init; never place plaintext passwords here.
MAPI_REMOTE_OWNER_PASSWORD_HASH=

# MAPI_OWNER_KEY: Neutral single-instance owner identifier. Optional.
MAPI_OWNER_KEY=owner

# MAPI_AGENT_SUBJECT_KEY: Stable subject identifier for the neutral Agent Self Model.
# Keep this stable across restarts for one assistant identity.
MAPI_AGENT_SUBJECT_KEY=agent

# MAPI_AGENT_DISPLAY_NAME: Human-readable assistant name used only in read surfaces.
MAPI_AGENT_DISPLAY_NAME=Agent

# MAPI_AGENT_PROJECT_KEY: Dedicated project namespace that stores explicit self evidence.
# Do not reuse a customer/project namespace here.
MAPI_AGENT_PROJECT_KEY=agent-self

# MAPI_SEMANTIC_ENABLED: Enable optional semantic retrieval. Optional.
# Requires installation with the semantic extra and may download a model.
MAPI_SEMANTIC_ENABLED=false

# MAPI_EMBEDDING_MODEL: Optional sentence-transformers model identifier.
# Security/network: the first use may download model files.
MAPI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# GEMINI_API_KEY: Optional. Leave empty to disable Gemini.
# Security: secret; never commit a real value.
GEMINI_API_KEY=

# MAPI_GEMINI_ENABLED: Optional provider gate. Disabled by default.
MAPI_GEMINI_ENABLED=false

# MAPI_LOCAL_MODEL_ENABLED: Optional local-model provider gate. Disabled by default.
MAPI_LOCAL_MODEL_ENABLED=false

# MAPI_LOCAL_MODEL_URL: Optional local provider endpoint.
MAPI_LOCAL_MODEL_URL=http://127.0.0.1:1234

# MAPI_LOG_DIR: Runtime log directory. Optional.
MAPI_LOG_DIR=./logs

# MAPI_LOG_LEVEL: Runtime logging verbosity. Optional.
MAPI_LOG_LEVEL=INFO

# MAPI_BACKUP_DIR: Local backup destination. Optional.
# Security: protect backups like the primary database.
MAPI_BACKUP_DIR=./backups

# MAPI_REQUEST_TIMEOUT_SECONDS: Outbound optional-provider timeout. Optional.
MAPI_REQUEST_TIMEOUT_SECONDS=30

# MAPI_RECOVERY_COMMAND_JSON: Optional local operator restart command as a JSON argv array.
# Example for a systemd VPS: ["systemctl","restart","mapi"]
# Used only by explicit `mapi-recover --execute`; never passed through a shell.
MAPI_RECOVERY_COMMAND_JSON=
